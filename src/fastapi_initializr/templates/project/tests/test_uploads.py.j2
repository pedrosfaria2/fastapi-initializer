"""File upload endpoint contract."""

import asyncio
from collections.abc import Iterator
from pathlib import Path
from typing import cast

import pytest
from fastapi import FastAPI
from fastapi.testclient import TestClient

from {{ spec.package }}.core.config import get_settings
from {{ spec.package }}.core.storage import LocalStorage, get_storage


@pytest.fixture
def storage(tmp_path: Path) -> LocalStorage:
    """Use a temporary directory instead of the configured upload path."""
    return LocalStorage(tmp_path)


@pytest.fixture
def upload_client(client: TestClient, storage: LocalStorage) -> Iterator[TestClient]:
    """Override the storage dependency for the application under test."""
    app = cast(FastAPI, client.app)
    app.dependency_overrides[get_storage] = lambda: storage
    try:
        yield client
    finally:
        app.dependency_overrides.clear()


def test_upload_download_and_delete(upload_client: TestClient) -> None:
    response = upload_client.post(
        "/uploads",
        files={"file": ("note.txt", b"hello uploads", "text/plain")},
    )

    assert response.status_code == 201
    key = response.json()["key"]
    assert key.endswith(".txt")

    download = upload_client.get(f"/uploads/{key}")
    assert download.status_code == 200
    assert download.content == b"hello uploads"

    assert upload_client.delete(f"/uploads/{key}").status_code == 204
    assert upload_client.get(f"/uploads/{key}").status_code == 404


def test_upload_rejects_oversized_file(
    upload_client: TestClient,
    monkeypatch: pytest.MonkeyPatch,
) -> None:
    monkeypatch.setenv("MAX_UPLOAD_BYTES", "4")
    get_settings.cache_clear()
    try:
        response = upload_client.post(
            "/uploads",
            files={"file": ("note.txt", b"too large", "text/plain")},
        )
    finally:
        get_settings.cache_clear()

    assert response.status_code == 413


def test_upload_rejects_disallowed_type(upload_client: TestClient) -> None:
    response = upload_client.post(
        "/uploads",
        files={"file": ("archive.zip", b"data", "application/zip")},
    )

    assert response.status_code == 415


def test_upload_rejects_path_traversal(
    upload_client: TestClient,
    storage: LocalStorage,
) -> None:
    assert upload_client.get("/uploads/..%2Fsecret.txt").status_code == 404
    with pytest.raises(ValueError, match="Unsafe storage key"):
        asyncio.run(storage.read("../secret.txt"))


def test_missing_upload_returns_404(upload_client: TestClient) -> None:
    assert upload_client.get("/uploads/missing.txt").status_code == 404
