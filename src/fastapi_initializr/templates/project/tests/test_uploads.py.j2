def test_upload_uses_the_validated_content_extension(upload_client: TestClient) -> None:
    headers = _auth_headers(upload_client, OWNER)

    response = upload_client.post(
        "/uploads",
        files={"file": ("evil.html", _png_bytes(), "image/png")},
        headers=headers,
    )

    assert response.status_code == 201
    key = response.json()["key"]
    assert key.endswith(".png")
    download = upload_client.get(f"/uploads/{key}", headers=headers)
    assert download.headers["content-disposition"] == f'attachment; filename="{key}"'


def test_upload_rejects_unknown_configured_type(
    monkeypatch: pytest.MonkeyPatch,
) -> None:
    monkeypatch.setenv("ALLOWED_UPLOAD_TYPES", '["image/gif"]')
    get_settings.cache_clear()
    try:
        with pytest.raises(ValueError, match="Unsupported upload types"):
            get_settings()
    finally:
        get_settings.cache_clear()


