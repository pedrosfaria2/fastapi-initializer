from {{ spec.package }}.main import create_app

EMAIL = "user@example.com"
NEW_EMAIL = "social@example.com"
CREDENTIAL = "correct-horse-battery"
PROVIDERS = ("google", "github")


class FakeOAuthClient:
    """Deterministic provider that never contacts the network."""

    def __init__(
        self,
        email: str,
        *,
        subject: str = "provider-subject",
        github_id: int = 12345,
        google_verified: bool | str = True,
        github_verified: bool = True,
        public_email: str | None = None,
    ) -> None:
        self.email = email
        self.subject = subject
        self.github_id = github_id
        self.google_verified = google_verified
        self.github_verified = github_verified
        self.public_email = public_email
        self.redirect_uri: str | None = None
        self.requested_paths: list[str] = []

    async def authorize_redirect(self, request: Request, redirect_uri: str) -> Response:
        """Return a fixed authorization redirect."""
        _ = request
        self.redirect_uri = redirect_uri
        return RedirectResponse("https://provider.example/authorize")

    async def authorize_access_token(self, request: Request) -> Mapping[str, object]:
        """Return a token shaped like an OIDC token response."""
        _ = request
        return {
            "userinfo": {
                "sub": self.subject,
                "email": self.email,
                "email_verified": self.google_verified,
            },
            "access_token": "provider-token",
        }

    async def get_json(self, path: str, token: Mapping[str, object]) -> object:
        """Return fixed GitHub profile responses."""
        _ = token
        self.requested_paths.append(path)
        if path == "user":
            return {"id": self.github_id, "email": self.public_email or self.email}
        if path == "user/emails":
            return [{"email": self.email, "primary": True, "verified": self.github_verified}]
        raise AssertionError(f"unexpected provider path: {path}")


class SyncResponse:
    """An Authlib-like response whose ``json`` method is synchronous."""

    def json(self) -> object:
        return {"id": 12345}


class SyncAuthlibClient:
    """The subset of Authlib used by the adapter, returning sync JSON."""

    async def authorize_redirect(self, request: Request, redirect_uri: str) -> Response:
        _ = (request, redirect_uri)
        raise AssertionError("not used")

    async def authorize_access_token(self, request: Request) -> Mapping[str, object]:
        _ = request
        raise AssertionError("not used")

    async def get(self, path: str, *, token: Mapping[str, object]) -> SyncResponse:
        _ = (path, token)
        return SyncResponse()


def _install_fake(
    client: TestClient,
    email: str,
    *,
    subject: str = "provider-subject",
    github_id: int = 12345,
    google_verified: bool | str = True,
    github_verified: bool = True,
    public_email: str | None = None,
) -> FakeOAuthClient:
    fake = FakeOAuthClient(
        email,
        subject=subject,
        github_id=github_id,
        google_verified=google_verified,
        github_verified=github_verified,
        public_email=public_email,
    )
    app = cast(FastAPI, client.app)
    app.dependency_overrides[get_oauth_client] = lambda: fake
    return fake


def _register(client: TestClient, email: str = EMAIL) -> None:
    response = client.post(
        "/auth/register",
        json={"email": email, "password": CREDENTIAL},
    )
    assert response.status_code == 202


def _callback(client: TestClient, provider: str = "google") -> str:
    response = client.get(
        f"/auth/oauth/{provider}/callback",
        params={"code": "fake-code", "state": "fake-state"},
    )
    assert response.status_code == 200
    token = response.json()["access_token"]
    assert isinstance(token, str)
    return token


def _me(client: TestClient, token: str) -> Mapping[str, object]:
    response = client.get(
        "/auth/me",
        headers={"Authorization": f"Bearer {token}"},
    )
    assert response.status_code == 200
    return cast(Mapping[str, object], response.json())


@pytest.mark.parametrize("provider", PROVIDERS)
def test_login_redirects_to_provider(client: TestClient, provider: str) -> None:
    fake = _install_fake(client, EMAIL)

    response = client.get(
        f"/auth/oauth/{provider}/login",
        follow_redirects=False,
    )

    assert response.status_code == 307
    assert response.headers["location"] == "https://provider.example/authorize"
    assert fake.redirect_uri == f"http://localhost:8000/auth/oauth/{provider}/callback"


@pytest.mark.parametrize("provider", PROVIDERS)
def test_callback_returns_token(client: TestClient, provider: str) -> None:
    fake = _install_fake(client, EMAIL)

    token = _callback(client, provider)

    assert token
    expected_paths = ["user", "user/emails"] if provider == "github" else []
    assert fake.requested_paths == expected_paths


@pytest.mark.parametrize("provider", PROVIDERS)
def test_callback_rejects_an_unverified_email(client: TestClient, provider: str) -> None:
    _install_fake(
        client,
        EMAIL,
        google_verified=False,
        github_verified=False,
        public_email=EMAIL,
    )

    response = client.get(
        f"/auth/oauth/{provider}/callback",
        params={"code": "fake-code", "state": "fake-state"},
    )

    assert response.status_code == 400


def test_google_accepts_a_string_verified_claim(client: TestClient) -> None:
    _install_fake(client, EMAIL, google_verified="true")

    token = _callback(client, "google")

    assert _me(client, token)["email"] == EMAIL


def test_google_requires_a_subject(client: TestClient) -> None:
    _install_fake(client, EMAIL, subject="")

    response = client.get(
        "/auth/oauth/google/callback",
        params={"code": "fake-code", "state": "fake-state"},
    )

    assert response.status_code == 400


def test_github_ignores_the_unverified_profile_email(client: TestClient) -> None:
    fake = _install_fake(client, NEW_EMAIL, public_email=EMAIL)

    token = _callback(client, "github")

    assert _me(client, token)["email"] == NEW_EMAIL
    assert fake.requested_paths == ["user", "user/emails"]


def test_unverified_email_does_not_link_an_existing_account(client: TestClient) -> None:
    _register(client)
    _install_fake(client, EMAIL, google_verified=False)

    response = client.get(
        "/auth/oauth/google/callback",
        params={"code": "fake-code", "state": "fake-state"},
    )

    assert response.status_code == 400


def test_verified_email_does_not_link_an_existing_password_account(client: TestClient) -> None:
    _register(client)
    _install_fake(client, EMAIL)

    response = client.get(
        "/auth/oauth/google/callback",
        params={"code": "fake-code", "state": "fake-state"},
    )

    assert response.status_code == 409
    login = client.post(
        "/auth/login",
        data={"username": EMAIL, "password": CREDENTIAL},
    )
    assert login.status_code == 200


def test_callback_reuses_an_oauth_account(client: TestClient) -> None:
    _install_fake(client, NEW_EMAIL)

    first = _me(client, _callback(client))
    second = _me(client, _callback(client))

    assert first["id"] == second["id"]
    assert first["email"] == NEW_EMAIL


def test_callback_creates_new_user(client: TestClient) -> None:
    _install_fake(client, NEW_EMAIL)

    token = _callback(client)
    body = _me(client, token)

    assert body["email"] == NEW_EMAIL
