@pytest.mark.parametrize("endpoint", ["login", "callback"])
def test_unknown_provider_returns_bad_request(
    client: TestClient,
    endpoint: str,
) -> None:
    _install_fake(client, EMAIL)

    response = client.get(
        f"/auth/oauth/gitlab/{endpoint}",
        follow_redirects=False,
    )

    assert response.status_code == 400


def test_callback_without_identity_returns_bad_request(client: TestClient) -> None:
    _install_fake(client, "")

    response = client.get(
        "/auth/oauth/google/callback",
        params={"code": "fake-code", "state": "fake-state"},
    )

    assert response.status_code == 400


def test_authlib_adapter_accepts_sync_json() -> None:
    adapter = AuthlibOAuthClient(SyncAuthlibClient())

    assert asyncio.run(adapter.get_json("user", {})) == {"id": 12345}


def test_oauth_session_cookie_is_secure_in_production(
    monkeypatch: pytest.MonkeyPatch,
) -> None:
    monkeypatch.setenv("ENVIRONMENT", "production")
    monkeypatch.setenv("SECRET_KEY", "x" * 32)
    get_settings.cache_clear()
    try:
        app = create_app()
    finally:
        get_settings.cache_clear()

    session = next(item for item in app.user_middleware if item.cls is SessionMiddleware)
    assert session.kwargs["https_only"] is True
