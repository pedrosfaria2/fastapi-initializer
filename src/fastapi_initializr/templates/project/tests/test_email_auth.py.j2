"""Password reset and email verification endpoint contract."""

import secrets
from concurrent.futures import ThreadPoolExecutor
from typing import cast

import pytest
from fastapi import FastAPI
from fastapi.testclient import TestClient

from {{ spec.package }}.core.config import get_settings
from {{ spec.package }}.core.email import EmailMessage, get_email_backend

EMAIL = "user@example.com"
MISSING_EMAIL = "missing@example.com"
CREDENTIAL = secrets.token_urlsafe(18)
NEW_CREDENTIAL = secrets.token_urlsafe(18)
GENERIC_MESSAGE = "If the email is registered, a message has been sent."


class RecordingEmailBackend:
    """Capture sent messages without contacting an SMTP server."""

    def __init__(self) -> None:
        self.messages: list[EmailMessage] = []

    async def send(self, message: EmailMessage) -> None:
        """Record one outgoing message."""
        self.messages.append(message)


def _install_backend(client: TestClient) -> RecordingEmailBackend:
    backend = RecordingEmailBackend()
    app = cast(FastAPI, client.app)
    app.dependency_overrides[get_email_backend] = lambda: backend
    return backend


def _register(client: TestClient) -> None:
    response = client.post(
        "/auth/register",
        json={"email": EMAIL, "password": CREDENTIAL},
    )
    assert response.status_code == 202


def _login(client: TestClient, password: str = CREDENTIAL) -> int:
    response = client.post(
        "/auth/login",
        data={"username": EMAIL, "password": password},
    )
    return response.status_code


def _extract_token(body: str) -> str:
    prefix = "Token: "
    for line in body.splitlines():
        if line.startswith(prefix):
            return line.removeprefix(prefix)
    raise AssertionError("email body does not contain a token")


def test_password_reset_flow(client: TestClient) -> None:
    _register(client)
    backend = _install_backend(client)

    response = client.post("/auth/request-password-reset", json={"email": EMAIL})

    assert response.status_code == 202
    assert response.json()["message"] == GENERIC_MESSAGE
    assert len(backend.messages) == 1
    token = _extract_token(backend.messages[0].body)

    reset = client.post(
        "/auth/reset-password",
        json={"token": token, "new_password": NEW_CREDENTIAL},
    )

    assert reset.status_code == 204
    assert len(backend.messages) == 2
    assert backend.messages[1].subject == "Your password was changed"
    assert _login(client, password=NEW_CREDENTIAL) == 200
    assert _login(client) == 401

    reused = client.post(
        "/auth/reset-password",
        json={"token": token, "new_password": CREDENTIAL},
    )
    assert reused.status_code == 401
    assert _login(client, password=NEW_CREDENTIAL) == 200


def test_verify_email_sets_verified_flag(client: TestClient) -> None:
    _register(client)
    backend = _install_backend(client)

    response = client.post("/auth/request-verification", json={"email": EMAIL})

    assert response.status_code == 202
    assert response.json()["message"] == GENERIC_MESSAGE
    assert len(backend.messages) == 1
    token = _extract_token(backend.messages[0].body)

    verify = client.post("/auth/verify-email", json={"token": token})

    assert verify.status_code == 204
    reused = client.post("/auth/verify-email", json={"token": token})
    assert reused.status_code == 401
    login = client.post(
        "/auth/login",
        data={"username": EMAIL, "password": CREDENTIAL},
    )
    access_token = login.json()["access_token"]
    me = client.get(
        "/auth/me",
        headers={"Authorization": f"Bearer {access_token}"},
    )
    assert me.status_code == 200
    assert me.json()["is_verified"] is True


def test_unknown_email_returns_generic_response_without_sending(
    client: TestClient,
) -> None:
    backend = _install_backend(client)

    for path in ("/auth/request-password-reset", "/auth/request-verification"):
        response = client.post(path, json={"email": MISSING_EMAIL})
        assert response.status_code == 202
        assert response.json()["message"] == GENERIC_MESSAGE

    assert not backend.messages


def test_invalid_action_token_returns_bad_request(client: TestClient) -> None:
    _register(client)

    reset = client.post(
        "/auth/reset-password",
        json={"token": "not-a-token", "new_password": NEW_CREDENTIAL},
    )
    verify = client.post("/auth/verify-email", json={"token": "not-a-token"})

    assert reset.status_code == 401
    assert verify.status_code == 401


def test_password_reset_token_is_consumed_once(client: TestClient) -> None:
    _register(client)
    backend = _install_backend(client)
    assert client.post("/auth/request-password-reset", json={"email": EMAIL}).status_code == 202
    token = _extract_token(backend.messages[0].body)

    def reset() -> int:
        return client.post(
            "/auth/reset-password",
            json={"token": token, "new_password": NEW_CREDENTIAL},
        ).status_code

    with ThreadPoolExecutor(max_workers=4) as pool:
        statuses = list(pool.map(lambda _: reset(), range(4)))

    assert statuses.count(204) == 1
    assert statuses.count(401) == 3


def test_email_verification_token_is_consumed_once(client: TestClient) -> None:
    _register(client)
    backend = _install_backend(client)
    assert client.post("/auth/request-verification", json={"email": EMAIL}).status_code == 202
    token = _extract_token(backend.messages[0].body)

    def verify() -> int:
        return client.post("/auth/verify-email", json={"token": token}).status_code

    with ThreadPoolExecutor(max_workers=4) as pool:
        statuses = list(pool.map(lambda _: verify(), range(4)))

    assert statuses.count(204) == 1
    assert statuses.count(401) == 3


def test_production_rejects_console_email_backend(
    monkeypatch: pytest.MonkeyPatch,
) -> None:
    monkeypatch.setenv("ENVIRONMENT", "production")
    monkeypatch.setenv("SECRET_KEY", "x" * 32)
    monkeypatch.setenv("EMAIL_BACKEND", "console")
    get_settings.cache_clear()
    try:
        with pytest.raises(ValueError, match="EMAIL_BACKEND"):
            get_settings()
    finally:
        get_settings.cache_clear()
