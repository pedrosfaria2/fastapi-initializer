"""Sentry initialization without network access."""

from fastapi.testclient import TestClient

from {{ spec.package }}.{{ layout.config_import }} import Settings
from {{ spec.package }}.{{ layout.observability_import }} import init_sentry


def test_sentry_init_is_disabled_without_dsn() -> None:
    init_sentry(Settings(sentry_dsn=""))


def test_app_starts_without_sentry_dsn(client: TestClient) -> None:
    response = client.get("/health")

    assert response.status_code == 200
