"""Document CRUD endpoint contract."""

from fastapi.testclient import TestClient


def test_create_document(client: TestClient) -> None:
    response = client.post(
        "/documents",
        json={"name": "first", "description": "example"},
    )

    assert response.status_code == 201
    body = response.json()
    assert body["id"]
    assert body["name"] == "first"
    assert body["description"] == "example"
    assert body["created_at"]


def test_list_documents_is_paginated(client: TestClient) -> None:
    for name in ("one", "two", "three"):
        assert client.post("/documents", json={"name": name}).status_code == 201

    response = client.get("/documents", params={"limit": 1, "offset": 1})

    assert response.status_code == 200
    body = response.json()
    assert [document["name"] for document in body] == ["two"]
    assert client.get("/documents", params={"limit": 0}).status_code == 422
    assert client.get("/documents", params={"limit": 101}).status_code == 422
    assert client.get("/documents", params={"offset": -1}).status_code == 422


def test_get_document(client: TestClient) -> None:
    created = client.post("/documents", json={"name": "first"}).json()

    response = client.get(f"/documents/{created['id']}")

    assert response.status_code == 200
    body = response.json()
    assert body["id"] == created["id"]
    assert body["name"] == "first"
    assert body["description"] == ""
    assert body["created_at"]


def test_update_document(client: TestClient) -> None:
    created = client.post("/documents", json={"name": "first"}).json()

    response = client.patch(
        f"/documents/{created['id']}",
        json={"description": "updated"},
    )

    assert response.status_code == 200
    body = response.json()
    assert body["name"] == "first"
    assert body["description"] == "updated"


def test_delete_document(client: TestClient) -> None:
    created = client.post("/documents", json={"name": "first"}).json()

    response = client.delete(f"/documents/{created['id']}")

    assert response.status_code == 204
    assert client.get(f"/documents/{created['id']}").status_code == 404


def test_missing_document_returns_404(client: TestClient) -> None:
    missing_id = "000000000000000000000000"

    assert client.get(f"/documents/{missing_id}").status_code == 404
    assert client.get("/documents/not-an-object-id").status_code == 404
    assert (
        client.patch(
            f"/documents/{missing_id}",
            json={"name": "missing"},
        ).status_code
        == 404
    )
    assert client.delete(f"/documents/{missing_id}").status_code == 404
