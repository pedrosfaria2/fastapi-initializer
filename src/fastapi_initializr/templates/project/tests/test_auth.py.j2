class RecordingEmailBackend:
    """Capture sent messages without contacting an SMTP server."""

    def __init__(self) -> None:
        self.messages: list[EmailMessage] = []

    async def send(self, message: EmailMessage) -> None:
        """Record one outgoing message."""
        self.messages.append(message)


def _action_token(client: TestClient, path: str) -> str:
    backend = RecordingEmailBackend()
    app = cast(FastAPI, client.app)
    app.dependency_overrides[get_email_backend] = lambda: backend
    response = client.post(path, json={"email": EMAIL})
    assert response.status_code == 202
    body = backend.messages[-1].body
    return next(
        line.removeprefix("Token: ") for line in body.splitlines() if line.startswith("Token: ")
    )


def test_require_verified_email_blocks_login_until_verified(
    client: TestClient,
    monkeypatch: pytest.MonkeyPatch,
) -> None:
    _register(client)
    monkeypatch.setenv("REQUIRE_VERIFIED_EMAIL", "true")
    get_settings.cache_clear()
    try:
        blocked = client.post(
            "/auth/login",
            data={"username": EMAIL, "password": CREDENTIAL},
        )
        assert blocked.status_code == 403

        token = _action_token(client, "/auth/request-verification")
        verified = client.post("/auth/verify-email", json={"token": token})
        assert verified.status_code == 204
        assert _login(client)
    finally:
        get_settings.cache_clear()


@pytest.mark.parametrize(
    "path",
    ["/auth/request-password-reset", "/auth/request-verification"],
)
def test_action_tokens_cannot_authenticate(client: TestClient, path: str) -> None:
    _register(client)
    token = _action_token(client, path)

    response = client.get(
        "/auth/me",
        headers={"Authorization": f"Bearer {token}"},
    )

    assert response.status_code == 401


def test_password_reset_revokes_previous_access_tokens(client: TestClient) -> None:
    _register(client)
    access_token = _login(client)
    reset_token = _action_token(client, "/auth/request-password-reset")

    reset = client.post(
        "/auth/reset-password",
        json={"token": reset_token, "new_password": NEW_CREDENTIAL},
    )

    assert reset.status_code == 204
    old = client.get(
        "/auth/me",
        headers={"Authorization": f"Bearer {access_token}"},
    )
    assert old.status_code == 401
    assert _login(client, credential=NEW_CREDENTIAL)
