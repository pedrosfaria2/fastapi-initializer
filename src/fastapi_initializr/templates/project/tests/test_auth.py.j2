EMAIL = "user@example.com"
CREDENTIAL = secrets.token_urlsafe(18)
DIFFERENT_CREDENTIAL = secrets.token_urlsafe(18)
WRONG_CREDENTIAL = secrets.token_urlsafe(18)
NEW_CREDENTIAL = secrets.token_urlsafe(18)
STRONG_SECRET = secrets.token_urlsafe(48)


def _register(client: TestClient, email: str = EMAIL) -> None:
    response = client.post(
        "/auth/register",
        json={"email": email, "password": CREDENTIAL},
    )
    assert response.status_code == 202


def _login(
    client: TestClient,
    email: str = EMAIL,
    credential: str = CREDENTIAL,
) -> str:
    response = client.post(
        "/auth/login",
        data={"username": email, "password": credential},
    )
    assert response.status_code == 200
    token = response.json()["access_token"]
    assert isinstance(token, str)
    return token


def test_register_returns_a_generic_response(client: TestClient) -> None:
    response = client.post(
        "/auth/register",
        json={"email": EMAIL, "password": CREDENTIAL},
    )

    assert response.status_code == 202
    assert response.json() == {
        "message": "If the email is available, the account is ready to sign in."
    }


def test_short_password_is_rejected(client: TestClient) -> None:
    response = client.post(
        "/auth/register",
        json={"email": "short@example.com", "password": "x" * 4},
    )

    assert response.status_code == 422


def test_duplicate_registration_does_not_replace_the_password(client: TestClient) -> None:
    _register(client)

    duplicate = client.post(
        "/auth/register",
        json={"email": EMAIL, "password": DIFFERENT_CREDENTIAL},
    )

    assert duplicate.status_code == 202
    assert _login(client)
    wrong = client.post(
        "/auth/login",
        data={"username": EMAIL, "password": DIFFERENT_CREDENTIAL},
    )
    assert wrong.status_code == 401


def test_login_returns_token(client: TestClient) -> None:
    _register(client)

    assert _login(client)


def test_email_case_variants_share_one_account(client: TestClient) -> None:
    _register(client, "User@Example.COM")

    assert _login(client, EMAIL)
    duplicate = client.post(
        "/auth/register",
        json={"email": "USER@example.com", "password": DIFFERENT_CREDENTIAL},
    )
    assert duplicate.status_code == 202
    wrong = client.post(
        "/auth/login",
        data={"username": EMAIL, "password": DIFFERENT_CREDENTIAL},
    )
    assert wrong.status_code == 401


def test_wrong_password_returns_unauthorized(client: TestClient) -> None:
    _register(client)

    response = client.post(
        "/auth/login",
        data={"username": EMAIL, "password": WRONG_CREDENTIAL},
    )

    assert response.status_code == 401


def test_auth_responses_are_not_cacheable(client: TestClient) -> None:
    _register(client)
    token = _login(client)

    me = client.get("/auth/me", headers={"Authorization": f"Bearer {token}"})

    assert me.headers["cache-control"] == "no-store"
    assert me.headers["pragma"] == "no-cache"
    assert "Authorization" in me.headers["vary"]


def test_me_returns_authenticated_user(client: TestClient) -> None:
    _register(client)
    token = _login(client)

    response = client.get(
        "/auth/me",
        headers={"Authorization": f"Bearer {token}"},
    )

    assert response.status_code == 200
    assert response.json()["email"] == EMAIL


def test_me_without_token_returns_unauthorized(client: TestClient) -> None:
