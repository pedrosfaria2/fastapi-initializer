EMAIL = "user@example.com"
CREDENTIAL = "correct-horse-battery"


def _register(client: TestClient, email: str = EMAIL) -> None:
    response = client.post(
        "/auth/register",
        json={"email": email, "password": CREDENTIAL},
    )
    assert response.status_code == 202


def _login(
    client: TestClient,
    email: str = EMAIL,
    credential: str = CREDENTIAL,
) -> str:
    response = client.post(
        "/auth/login",
        data={"username": email, "password": credential},
    )
    assert response.status_code == 200
    token = response.json()["access_token"]
    assert isinstance(token, str)
    return token


def test_register_returns_a_generic_response(client: TestClient) -> None:
    response = client.post(
        "/auth/register",
        json={"email": EMAIL, "password": CREDENTIAL},
    )

    assert response.status_code == 202
    assert response.json() == {
        "message": "If the email is available, the account is ready to sign in."
    }


def test_short_password_is_rejected(client: TestClient) -> None:
    response = client.post(
        "/auth/register",
        json={"email": "short@example.com", "password": "short"},
    )

    assert response.status_code == 422


def test_duplicate_registration_does_not_replace_the_password(client: TestClient) -> None:
    _register(client)

    duplicate = client.post(
        "/auth/register",
        json={"email": EMAIL, "password": "different-password"},
    )

    assert duplicate.status_code == 202
    assert _login(client)
    wrong = client.post(
        "/auth/login",
        data={"username": EMAIL, "password": "different-password"},
    )
    assert wrong.status_code == 401


def test_login_returns_token(client: TestClient) -> None:
    _register(client)

    assert _login(client)


def test_wrong_password_returns_unauthorized(client: TestClient) -> None:
    _register(client)

    response = client.post(
        "/auth/login",
        data={"username": EMAIL, "password": "wrong-password"},
    )

    assert response.status_code == 401


def test_me_returns_authenticated_user(client: TestClient) -> None:
    _register(client)
    token = _login(client)

    response = client.get(
        "/auth/me",
        headers={"Authorization": f"Bearer {token}"},
    )

    assert response.status_code == 200
    assert response.json()["email"] == EMAIL


def test_me_without_token_returns_unauthorized(client: TestClient) -> None:
    assert client.get("/auth/me").status_code == 401


def test_me_with_invalid_token_returns_unauthorized(client: TestClient) -> None:
    response = client.get(
        "/auth/me",
        headers={"Authorization": "Bearer invalid-token"},
    )

    assert response.status_code == 401


def test_logout_revokes_all_access_tokens(client: TestClient) -> None:
    _register(client)
    first = _login(client)
    second = _login(client)

    response = client.post("/auth/logout", headers={"Authorization": f"Bearer {first}"})

    assert response.status_code == 204
    assert client.get("/auth/me", headers={"Authorization": f"Bearer {first}"}).status_code == 401
    assert client.get("/auth/me", headers={"Authorization": f"Bearer {second}"}).status_code == 401
    assert _login(client)


def test_wrong_issuer_or_audience_is_rejected(client: TestClient) -> None:
    _register(client)
    settings = get_settings()
    claims = {
        "sub": EMAIL,
        "exp": int(time.time()) + 600,
        "ver": 0,
        "typ": "access",
        "iss": settings.app_name,
        "aud": settings.app_name,
    }
    for field in ("iss", "aud"):
        token = jwt.encode(
            {**claims, field: "another-service"},
            settings.secret_key,
            algorithm=settings.jwt_algorithm,
        )
        response = client.get(
            "/auth/me",
            headers={"Authorization": f"Bearer {token}"},
        )
        assert response.status_code == 401


def test_production_rejects_placeholder_secrets(
    monkeypatch: pytest.MonkeyPatch,
) -> None:
    monkeypatch.setenv("ENVIRONMENT", "production")
    try:
        for secret in (
            "dev-secret-change-me-32-bytes-minimum",
            "change-me-in-production-32-bytes-minimum",
            "too-short",
        ):
            monkeypatch.setenv("SECRET_KEY", secret)
            get_settings.cache_clear()
            with pytest.raises(ValueError, match="SECRET_KEY"):
                get_settings()
    finally:
        get_settings.cache_clear()


def test_production_accepts_a_strong_secret(
    monkeypatch: pytest.MonkeyPatch,
) -> None:
    monkeypatch.setenv("ENVIRONMENT", "production")
    monkeypatch.setenv("SECRET_KEY", "x" * 32)
