def test_login_is_rate_limited(client: TestClient) -> None:
    for _ in range(10):
        response = client.post(
            "/auth/login",
            data={"username": "missing@example.com", "password": "wrong-password"},
        )
        assert response.status_code == 401

    limited = client.post(
        "/auth/login",
        data={"username": "missing@example.com", "password": "wrong-password"},
    )
    assert limited.status_code == 429
