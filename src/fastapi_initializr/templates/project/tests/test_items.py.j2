"""Item CRUD endpoint contract."""

from fastapi.testclient import TestClient

EMAIL = "owner@example.com"
OTHER_EMAIL = "other@example.com"
CREDENTIAL = "correct-horse-battery"


{% if spec.has("auth-jwt") %}
def _auth_headers(client: TestClient, email: str = EMAIL) -> dict[str, str]:
    registration = client.post(
        "/auth/register",
        json={"email": email, "password": CREDENTIAL},
    )
    assert registration.status_code == 202
    login = client.post(
        "/auth/login",
        data={"username": email, "password": CREDENTIAL},
    )
    assert login.status_code == 200
    return {"Authorization": f"Bearer {login.json()['access_token']}"}
{% else %}
def _auth_headers(client: TestClient, email: str = EMAIL) -> dict[str, str]:
    _ = (client, email)
    return {}
{% endif %}


def test_create_item(client: TestClient) -> None:
    headers = _auth_headers(client)
    response = client.post(
        "/items",
        json={"name": "first", "description": "example"},
        headers=headers,
    )

    assert response.status_code == 201
    body = response.json()
    assert body["id"] == 1
    assert body["name"] == "first"
    assert body["description"] == "example"
    assert body["created_at"]


def test_list_items_is_paginated(client: TestClient) -> None:
    headers = _auth_headers(client)
    for name in ("one", "two", "three"):
        assert client.post("/items", json={"name": name}, headers=headers).status_code == 201

    response = client.get("/items", params={"limit": 1, "offset": 1}, headers=headers)

    assert response.status_code == 200
    body = response.json()
    assert [item["name"] for item in body] == ["two"]
    assert client.get("/items", params={"limit": 0}, headers=headers).status_code == 422
    assert client.get("/items", params={"limit": 101}, headers=headers).status_code == 422
    assert client.get("/items", params={"offset": -1}, headers=headers).status_code == 422


def test_get_item(client: TestClient) -> None:
    headers = _auth_headers(client)
    created = client.post("/items", json={"name": "first"}, headers=headers).json()

    response = client.get(f"/items/{created['id']}", headers=headers)

    assert response.status_code == 200
    assert response.json() == created


def test_update_item(client: TestClient) -> None:
    headers = _auth_headers(client)
    created = client.post("/items", json={"name": "first"}, headers=headers).json()

    response = client.patch(
        f"/items/{created['id']}",
        json={"description": "updated"},
        headers=headers,
    )

    assert response.status_code == 200
    body = response.json()
    assert body["name"] == "first"
    assert body["description"] == "updated"


def test_delete_item(client: TestClient) -> None:
    headers = _auth_headers(client)
    created = client.post("/items", json={"name": "first"}, headers=headers).json()

    response = client.delete(f"/items/{created['id']}", headers=headers)

    assert response.status_code == 204
    assert client.get(f"/items/{created['id']}", headers=headers).status_code == 404


def test_missing_item_returns_404(client: TestClient) -> None:
    headers = _auth_headers(client)

    assert client.get("/items/999", headers=headers).status_code == 404
    assert client.patch("/items/999", json={"name": "missing"}, headers=headers).status_code == 404
    assert client.delete("/items/999", headers=headers).status_code == 404
{% if spec.has("auth-jwt") %}


def test_items_are_scoped_to_the_owner(client: TestClient) -> None:
    owner = _auth_headers(client, EMAIL)
    other = _auth_headers(client, OTHER_EMAIL)
    created = client.post("/items", json={"name": "private"}, headers=owner).json()
    item_id = created["id"]

    assert client.get("/items", headers=other).json() == []
    assert client.get(f"/items/{item_id}", headers=other).status_code == 404
    assert (
        client.patch(
            f"/items/{item_id}",
            json={"name": "stolen"},
            headers=other,
        ).status_code
        == 404
    )
    assert client.delete(f"/items/{item_id}", headers=other).status_code == 404
    assert client.get(f"/items/{item_id}", headers=owner).status_code == 200
{% endif %}
