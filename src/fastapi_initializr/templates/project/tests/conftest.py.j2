_ORIGINAL_LIST_COLLECTION_NAMES = MongoMockDatabase.list_collection_names


def _list_collection_names_compat(
    database: MongoMockDatabase,
    **_kwargs: object,
) -> list[str]:
    """Ignore pymongo options that mongomock does not support."""
    return _ORIGINAL_LIST_COLLECTION_NAMES(database)

