[project]
name = "{{ spec.name }}"
version = "{{ project_version }}"
description = "{{ spec.description | replace('\\', '\\\\') | replace('"', '\\"') }}"
readme = "README.md"
requires-python = ">={{ spec.python }}"
{% if author %}
authors = [{ name = "{{ author | replace('\\', '\\\\') | replace('"', '\\"') }}" }]
{% endif %}
dependencies = [
{% for package in core_packages %}
    "{{ package }}",
{% endfor %}
{% for package in packages %}
    "{{ package }}",
{% endfor %}
]

[dependency-groups]
dev = [
    "pytest>={{ pytest_version }}",
    "pytest-cov>=7.1.0",
    "httpx2>={{ httpx2_version }}",
    "ruff>={{ ruff_version }}",
    "mypy>={{ mypy_version }}",
    "pyright>={{ pyright_version }}",
{% for package in dev_packages %}
    "{{ package }}",
{% endfor %}
]

[project.scripts]
{{ spec.name }} = "{{ spec.package }}.main:main"

[tool.fastapi]
entrypoint = "{{ spec.package }}.main:app"

[build-system]
requires = ["uv_build>={{ uv_build_version }},<0.14.0"]
build-backend = "uv_build"

[tool.uv.build-backend]
module-name = "{{ spec.package }}"
module-root = "src"

[tool.ruff]
line-length = 100
target-version = "py{{ spec.python | replace('.', '') }}"
src = ["src", "tests"]

[tool.ruff.lint]
select = ["E4", "E7", "E9", "F", "I", "B", "UP", "SIM", "ASYNC", "S", "PT", "RUF", "N", "A", "C4", "PTH", "RET", "ARG", "T20"]

[tool.ruff.lint.per-file-ignores]
"tests/*" = ["S101", "PLR2004"]

[tool.mypy]
python_version = "{{ spec.python }}"
strict = true
files = ["src", "tests"]
plugins = ["pydantic.mypy"]
show_error_codes = true
warn_unreachable = true
{% if spec.has("s3") %}

[[tool.mypy.overrides]]
module = ["boto3", "boto3.*", "botocore", "botocore.*"]
ignore_missing_imports = true
{% endif %}
{% if spec.has("kubernetes") %}

[[tool.mypy.overrides]]
module = ["yaml", "yaml.*"]
ignore_missing_imports = true
{% endif %}
{% if spec.has("mongodb") %}

[[tool.mypy.overrides]]
module = ["mongomock_motor", "mongomock_motor.*"]
ignore_missing_imports = true
{% endif %}

[tool.pyright]
include = ["src", "tests"]
pythonVersion = "{{ spec.python }}"
typeCheckingMode = "strict"
reportMissingTypeStubs = false
venvPath = "."
venv = ".venv"

[tool.pytest.ini_options]
testpaths = ["tests"]
addopts = ["--import-mode=importlib", "-ra"]
markers = ["integration"]

[tool.coverage.run]
branch = true
source = ["src/{{ spec.package }}"]

[tool.coverage.report]
show_missing = true
