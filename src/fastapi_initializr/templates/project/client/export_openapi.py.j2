"""Export the FastAPI OpenAPI schema for client generation."""

import json
from pathlib import Path

from {{ spec.package }}.main import app


def main() -> None:
    """Write the current OpenAPI schema next to the client package."""
    Path("openapi.json").write_text(
        json.dumps(app.openapi(), indent=2) + "\n",
        encoding="utf-8",
    )


if __name__ == "__main__":
    main()
