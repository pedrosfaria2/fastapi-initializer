APP_NAME="{{ spec.name }}"
ENVIRONMENT=development
{% if spec.has_database %}
DATABASE_URL={{ spec.database_url }}
{% endif %}
{% if spec.has("redis") %}
REDIS_URL=redis://localhost:6379/0
{% endif %}
{% if spec.has("sentry") %}
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
{% endif %}
{% if spec.has("cors") %}
CORS_ORIGINS={{ spec.cors_origins | tojson }}
{% endif %}
{% if spec.has("auth-jwt") %}
SECRET_KEY=change-me-in-production-32-bytes-minimum
ACCESS_TOKEN_EXPIRE_MINUTES=30
{% endif %}
{% if spec.has("email") %}
EMAIL_BACKEND=console
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
SMTP_STARTTLS=true
{% endif %}
{% if spec.has("uploads") %}
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=5000000
ALLOWED_UPLOAD_TYPES=["image/png", "image/jpeg", "application/pdf", "text/plain"]
{% endif %}
{% if spec.has("s3") %}
STORAGE_BACKEND=local
S3_BUCKET=uploads
S3_ENDPOINT_URL=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
{% endif %}
