APP_NAME="{{ spec.name }}"
ENVIRONMENT=development
{% if spec.has_database %}
DATABASE_URL={{ spec.database_url }}
{% endif %}
{% if spec.has("redis") %}
REDIS_URL=redis://localhost:6379/0
{% endif %}
{% if spec.has("sentry") %}
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
{% endif %}
{% if spec.has("cors") %}
CORS_ORIGINS={{ spec.cors_origins | tojson }}
{% endif %}
{% if spec.has("auth-jwt") %}
SECRET_KEY=change-me-in-production-32-bytes-minimum
ACCESS_TOKEN_EXPIRE_MINUTES=30
{% endif %}
{% if spec.has("email") %}
EMAIL_BACKEND=console
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
SMTP_STARTTLS=true
{% endif %}
