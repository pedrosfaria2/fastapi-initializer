"""Application settings."""

from functools import lru_cache

from pydantic_settings import BaseSettings, SettingsConfigDict


class Settings(BaseSettings):
    """Runtime settings loaded from the environment."""

    model_config = SettingsConfigDict(
        env_file=".env",
        env_file_encoding="utf-8",
        extra="ignore",
    )

    app_name: str = "{{ app_title }}"
    environment: str = "development"
    log_level: str = "INFO"
{% if spec.has_database %}
    database_url: str = "{{ spec.database_url }}"
{% endif %}
{% if spec.has("redis") %}
    redis_url: str = "redis://localhost:6379/0"
{% endif %}
{% if spec.has("sentry") %}
    sentry_dsn: str = ""
    sentry_environment: str = "development"
{% endif %}
{% if spec.has("cors") %}
    cors_origins: list[str] = {{ spec.cors_origins | tojson }}
{% endif %}
{% if spec.has("auth-jwt") %}
    secret_key: str = "dev-secret-change-me-32-bytes-minimum"  # noqa: S105 - local placeholder
    access_token_expire_minutes: int = 30
    jwt_algorithm: str = "HS256"
{% endif %}
{% if spec.has("email") %}
    email_backend: str = "console"
    smtp_host: str = "localhost"
    smtp_port: int = 587
    smtp_username: str = ""
    smtp_password: str = ""
    smtp_from: str = "noreply@example.com"
    smtp_starttls: bool = True
{% endif %}


@lru_cache
def get_settings() -> Settings:
    """Return the cached application settings."""
    return Settings()
