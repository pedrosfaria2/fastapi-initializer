"""Application settings."""

from functools import lru_cache

{% if spec.has("uploads") %}
from pydantic import field_validator
{% endif %}
from pydantic_settings import BaseSettings, SettingsConfigDict
{% if spec.has("uploads") %}

from {{ spec.package }}.core.upload_validation import CONTENT_VALIDATORS
{% endif %}


class Settings(BaseSettings):
    """Runtime settings loaded from the environment."""

    model_config = SettingsConfigDict(
        env_file=".env",
        env_file_encoding="utf-8",
        extra="ignore",
    )

    app_name: str = {{ app_title | py_string }}
    environment: str = "development"
    log_level: str = "INFO"
    forwarded_allow_ips: str = ""
{% if spec.has_database %}
    database_url: str = "{{ spec.database_url }}"
{% endif %}
{% if spec.has("mongodb") %}
    mongodb_url: str = "mongodb://localhost:27017"
    mongodb_db: str = "app"
{% endif %}
{% if spec.has("redis") %}
    redis_url: str = "redis://localhost:6379/0"
{% endif %}
{% if spec.has("celery") %}
    celery_broker_url: str = "{{ spec.celery_broker_url }}"
{% endif %}
{% if spec.has("sentry") %}
    sentry_dsn: str = ""
    sentry_environment: str = "development"
{% endif %}
{% if spec.has("cors") %}
    cors_origins: list[str] = {{ spec.cors_origins | tojson }}
{% endif %}
{% if spec.has("auth-jwt") %}
    secret_key: str = "dev-secret-change-me-32-bytes-minimum"  # noqa: S105 - local placeholder
    access_token_expire_minutes: int = 5
    jwt_algorithm: str = "HS256"
{% endif %}
{% if spec.has("email") %}
    email_backend: str = "console"
    require_verified_email: bool = False
    smtp_host: str = "localhost"
    smtp_port: int = 587
    smtp_username: str = ""
    smtp_password: str = ""
    smtp_from: str = "noreply@example.com"
    smtp_starttls: bool = True
{% endif %}
{% if spec.has("oauth2") %}
    oauth_redirect_base_url: str = "http://localhost:8000"
    google_client_id: str = ""
    google_client_secret: str = ""
    github_client_id: str = ""
    github_client_secret: str = ""
{% endif %}
{% if spec.has("opentelemetry") %}
    otel_exporter_otlp_endpoint: str = ""
    otel_service_name: str = {{ app_title | py_string }}
    otel_environment: str = "development"
{% endif %}
{% if spec.has("uploads") %}
    upload_dir: str = "uploads"
    max_upload_bytes: int = 5_000_000
    allowed_upload_types: list[str] = [
        "image/png",
        "image/jpeg",
        "application/pdf",
        "text/plain",
    ]

    @field_validator("allowed_upload_types")
    @classmethod
    def validate_allowed_upload_types(cls, value: list[str]) -> list[str]:
        """Reject configured types that have no content validator."""
        unsupported = sorted(set(value) - set(CONTENT_VALIDATORS))
        if unsupported:
            raise ValueError(f"Unsupported upload types: {', '.join(unsupported)}")
        return value
{% endif %}
{% if spec.has("s3") %}

    storage_backend: str = "local"
    s3_bucket: str = "uploads"
    s3_endpoint_url: str = ""
    s3_region: str = "us-east-1"
    s3_access_key_id: str = ""
    s3_secret_access_key: str = ""
{% endif %}
{% if spec.has("auth-jwt") %}


def _validate_production_settings(settings: Settings) -> None:
    """Refuse development secrets when the app runs in production."""
    placeholders = frozenset(
        {
            "dev-secret-change-me-32-bytes-minimum",
            "change-me-in-production-32-bytes-minimum",
        }
    )
    if settings.environment.lower() == "production" and (
        settings.secret_key in placeholders or len(settings.secret_key) < 32
    ):
        raise ValueError(
            "SECRET_KEY must be a non-placeholder value with at least 32 characters in production."
        )
{% if spec.has("email") %}
    if settings.environment.lower() == "production" and settings.email_backend == "console":
        raise ValueError("EMAIL_BACKEND must be smtp in production.")
{% endif %}
{% endif %}


@lru_cache
def get_settings() -> Settings:
    """Return the cached application settings."""
{% if spec.has("auth-jwt") %}
    settings = Settings()
    _validate_production_settings(settings)
    return settings
{% else %}
    return Settings()
{% endif %}
