        "image/png",
        "image/jpeg",
        "application/pdf",
        "text/plain",
    ]

    @field_validator("allowed_upload_types")
    @classmethod
    def validate_allowed_upload_types(cls, value: list[str]) -> list[str]:
        """Reject configured types that have no content validator."""
        unsupported = sorted(set(value) - set(CONTENT_VALIDATORS))
        if unsupported:
            raise ValueError(f"Unsupported upload types: {', '.join(unsupported)}")
        return value
{% endif %}
{% if spec.has("s3") %}

    storage_backend: str = "local"
    s3_bucket: str = "uploads"
    s3_endpoint_url: str = ""
    s3_region: str = "us-east-1"
    s3_access_key_id: str = ""
    s3_secret_access_key: str = ""
{% endif %}

    @field_validator("environment", mode="before")
    @classmethod
    def normalize_environment(cls, value: object) -> object:
        """Normalize and validate the deployment environment name."""
        if not isinstance(value, str):
            raise ValueError("ENVIRONMENT must be a string")
        normalized = value.strip().lower()
        if normalized not in _VALID_ENVIRONMENTS:
            allowed = ", ".join(sorted(_VALID_ENVIRONMENTS))
            raise ValueError(f"ENVIRONMENT must be one of: {allowed}")
        return normalized

    @field_validator("forwarded_allow_ips")
    @classmethod
    def normalize_forwarded_allow_ips(cls, value: str) -> str:
        """Strip surrounding whitespace from the trusted proxy list."""
        return value.strip()
{% if spec.has("auth-jwt") %}

    @field_validator("secret_key")
    @classmethod
    def validate_secret_key(cls, value: str) -> str:
        """Reject empty, padded, and control-bearing master secrets."""
        if not value:
            raise ValueError("SECRET_KEY must not be empty")
        if value != value.strip():
            raise ValueError("SECRET_KEY must not have leading or trailing whitespace")
        if any(ord(character) < 32 for character in value):
            raise ValueError("SECRET_KEY must not contain control characters")
        return value

    @property
    def jwt_secret(self) -> str:
        """Return the key used to sign access tokens."""
        return _derive_key(self.secret_key, "jwt")

    @property
    def action_secret(self) -> str:
        """Return the key used to sign action tokens."""
        return _derive_key(self.secret_key, "action")

    @property
    def session_secret(self) -> str:
        """Return the key used to sign OAuth session cookies."""
        return _derive_key(self.secret_key, "session")
{% endif %}
{% if spec.has("auth-jwt") %}


def _validate_production_settings(settings: Settings) -> None:
    """Refuse weak configuration when the app runs in production."""
    if settings.environment != "production":
        return
    if settings.secret_key.lower() in _PLACEHOLDER_SECRETS:
        raise ValueError("SECRET_KEY must not be a placeholder in production.")
    if len(settings.secret_key) < _MIN_SECRET_LENGTH:
        raise ValueError(
            f"SECRET_KEY must have at least {_MIN_SECRET_LENGTH} characters in production."
        )
    if len(set(settings.secret_key)) < _MIN_UNIQUE_CHARACTERS:
        raise ValueError("SECRET_KEY must use at least 14 distinct characters in production.")
    if _shannon_entropy(settings.secret_key) < _MIN_ENTROPY:
        raise ValueError("SECRET_KEY has insufficient entropy for production.")
    if _is_repeated_pattern(settings.secret_key):
        raise ValueError("SECRET_KEY must not repeat a short pattern in production.")
    if settings.forwarded_allow_ips == "*":
        raise ValueError("FORWARDED_ALLOW_IPS must list explicit proxy addresses in production.")
{% if spec.has("email") %}
    if settings.email_backend == "console":
        raise ValueError("EMAIL_BACKEND must be smtp in production.")
{% endif %}
{% endif %}


@lru_cache
def get_settings() -> Settings:
    """Return the cached application settings."""
{% if spec.has("auth-jwt") %}
    settings = Settings()
    _validate_production_settings(settings)
    return settings
{% else %}
    return Settings()
{% endif %}
