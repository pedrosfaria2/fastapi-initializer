_VALID_ENVIRONMENTS = frozenset({"development", "test", "staging", "production"})
{% if spec.has("auth-jwt") %}

_PLACEHOLDER_SECRETS = frozenset(
    {
        "dev-secret-change-me-32-bytes-minimum",
        "change-me-in-production-32-bytes-minimum",
    }
)
_MIN_SECRET_LENGTH = 43
_MIN_UNIQUE_CHARACTERS = 14
_MIN_ENTROPY = 3.5


def _derive_key(secret: str, purpose: str) -> str:
    """Derive a purpose-specific key from the master secret."""
    digest = hmac.new(secret.encode(), purpose.encode(), hashlib.sha256).digest()
    return base64.urlsafe_b64encode(digest).decode()


def _shannon_entropy(value: str) -> float:
    """Return the per-character Shannon entropy of a string."""
    counts = Counter(value)
    length = len(value)
    return -sum((count / length) * math.log2(count / length) for count in counts.values())


def _is_repeated_pattern(value: str) -> bool:
    """Return whether the whole string repeats a shorter block."""
    return any(
        len(value) % size == 0 and value == value[:size] * (len(value) // size)
        for size in range(1, len(value) // 2 + 1)
    )
{% endif %}


