"""Baseline abuse protection for authentication endpoints."""

import time
from collections import OrderedDict, deque
from collections.abc import Awaitable, Callable
from typing import cast

from fastapi import HTTPException, Request, status

WINDOW_SECONDS = 60
MAX_TRACKED_CLIENTS = 10_000

REGISTER_LIMIT = 5
LOGIN_LIMIT = 10
LOGOUT_LIMIT = 10
ME_LIMIT = 60
PASSWORD_RESET_REQUEST_LIMIT = 5
PASSWORD_RESET_LIMIT = 10
VERIFICATION_REQUEST_LIMIT = 5
VERIFY_LIMIT = 10
OAUTH_LIMIT = 20


class AuthThrottle:
    """Bound authentication requests per client and scope."""

    def __init__(self) -> None:
        self._windows: OrderedDict[tuple[str, str], deque[float]] = OrderedDict()

    def allow(
        self,
        scope: str,
        client: str,
        limit: int,
        window_seconds: int = WINDOW_SECONDS,
    ) -> bool:
        """Record one request and return whether it is inside the limit."""
        now = time.monotonic()
        key = (scope, client)
        hits = self._windows.setdefault(key, deque())
        self._windows.move_to_end(key)
        while hits and hits[0] <= now - window_seconds:
            hits.popleft()
        if len(hits) >= limit:
            return False
        hits.append(now)
        if len(self._windows) > MAX_TRACKED_CLIENTS:
            self._windows.popitem(last=False)
        return True


def auth_rate_limit(
    scope: str,
    limit: int,
    window_seconds: int = WINDOW_SECONDS,
) -> Callable[[Request], Awaitable[None]]:
    """Return a dependency that throttles one authentication scope."""

    async def dependency(request: Request) -> None:
        throttle = cast(AuthThrottle, request.app.state.auth_throttle)
        client = request.client.host if request.client else "unknown"
        if not throttle.allow(scope, client, limit, window_seconds):
            raise HTTPException(
                status_code=status.HTTP_429_TOO_MANY_REQUESTS,
                detail="Rate limit exceeded",
                headers={"Retry-After": str(window_seconds)},
            )

    return dependency
