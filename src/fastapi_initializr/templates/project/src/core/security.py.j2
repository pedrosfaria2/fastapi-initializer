"""Password hashing and JWT helpers."""

from dataclasses import dataclass
from datetime import UTC, datetime, timedelta
from typing import Protocol, cast

import jwt
from jwt import InvalidTokenError
from pwdlib import PasswordHash
from pydantic import ValidationError

from {{ spec.package }}.{{ layout.config_import }} import get_settings
from {{ spec.package }}.{{ layout.schema("user") }} import TokenPayload

_PASSWORD_HASH = PasswordHash.recommended()


@dataclass(frozen=True, slots=True)
class ActionToken:
    """A decoded one-time action token."""

    subject: str
    version: int


class _JwtModule(Protocol):
    """The typed subset of PyJWT used by this project."""

    def encode(self, payload: dict[str, object], key: str, *, algorithm: str) -> str: ...

    def decode(
        self,
        token: str,
        key: str,
        *,
        algorithms: list[str],
        issuer: str | None = None,
        audience: str | None = None,
    ) -> dict[str, object]: ...


_PYJWT = cast(_JwtModule, jwt)


def hash_password(password: str) -> str:
    """Hash a plaintext password."""
    return _PASSWORD_HASH.hash(password)


def verify_password(password: str, hashed_password: str) -> bool:
    """Return whether a plaintext password matches its hash."""
    return _PASSWORD_HASH.verify(password, hashed_password)


def create_access_token(
    subject: str,
    version: int,
    expires_delta: timedelta | None = None,
) -> str:
    """Create a signed access token for a subject and token version."""
    settings = get_settings()
    expires_at = datetime.now(UTC) + (
        expires_delta or timedelta(minutes=settings.access_token_expire_minutes)
    )
    payload: dict[str, object] = {
        "sub": subject,
        "exp": expires_at,
        "ver": version,
        "typ": "access",
        "iss": settings.app_name,
        "aud": settings.app_name,
    }
    return _PYJWT.encode(payload, settings.secret_key, algorithm=settings.jwt_algorithm)


def decode_access_token(token: str) -> TokenPayload | None:
    """Return the token claims, or None when the token is invalid or expired."""
    settings = get_settings()
    try:
        payload = _PYJWT.decode(
            token,
            settings.secret_key,
            algorithms=[settings.jwt_algorithm],
            issuer=settings.app_name,
            audience=settings.app_name,
        )
        return TokenPayload.model_validate(payload)
    except (InvalidTokenError, ValidationError):
        return None


def create_action_token(
    subject: str,
    purpose: str,
    expires_minutes: int,
    version: int,
) -> str:
    """Create a short-lived token scoped to one action and account version."""
    settings = get_settings()
    expires_at = datetime.now(UTC) + timedelta(minutes=expires_minutes)
    payload: dict[str, object] = {
        "sub": subject,
        "purpose": purpose,
        "ver": version,
        "typ": "action",
        "exp": expires_at,
    }
    return _PYJWT.encode(payload, settings.secret_key, algorithm=settings.jwt_algorithm)


def decode_action_token(token: str, purpose: str) -> ActionToken | None:
    """Return the token claims when they match the expected purpose."""
    settings = get_settings()
    try:
        payload = _PYJWT.decode(
            token,
            settings.secret_key,
            algorithms=[settings.jwt_algorithm],
        )
    except InvalidTokenError:
        return None
    if payload.get("purpose") != purpose:
        return None
    if payload.get("typ") != "action":
        return None
    subject = payload.get("sub")
    version = payload.get("ver")
    if not isinstance(subject, str) or not subject:
        return None
    if not isinstance(version, int) or isinstance(version, bool) or version < 0:
        return None
    return ActionToken(subject=subject, version=version)
