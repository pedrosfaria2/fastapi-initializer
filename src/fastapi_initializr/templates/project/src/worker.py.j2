{% if spec.has("celery") %}
"""Celery worker configuration."""

from celery import Celery

from {{ spec.package }}.core.config import get_settings

celery_app = Celery("{{ spec.name }}", broker=get_settings().celery_broker_url)
celery_app.conf.update(  # pyright: ignore[reportUnknownMemberType]
    task_serializer="json",
    accept_content=["json"],
    result_serializer="json",
    timezone="UTC",
    enable_utc=True,
)


def _add(left: int, right: int) -> int:
    """Return the sum of two integers."""
    return left + right


add = celery_app.task(  # pyright: ignore[reportUnknownMemberType, reportUnknownVariableType]
    name="add"
)(_add)
{% else %}
"""ARQ worker configuration."""

from collections.abc import Awaitable, Callable
from typing import ClassVar

from arq.connections import RedisSettings

from {{ spec.package }}.core.config import get_settings
from {{ spec.package }}.tasks import example_task

ExampleTask = Callable[[dict[str, object], str], Awaitable[str]]


class WorkerSettings:
    """Settings used by ``arq {{ spec.package }}.worker.WorkerSettings``."""

    functions: ClassVar[list[ExampleTask]] = [example_task]
    redis_settings = RedisSettings.from_dsn(get_settings().redis_url)
{% endif %}
