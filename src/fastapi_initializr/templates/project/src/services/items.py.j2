"""Item service functions."""
{% if spec.has("sqlmodel") %}

from sqlmodel import select
from sqlmodel.ext.asyncio.session import AsyncSession
{% else %}

from sqlalchemy import select
from sqlalchemy.ext.asyncio import AsyncSession
{% endif %}

from {{ spec.package }}.{{ layout.model("item") }} import Item
from {{ spec.package }}.{{ layout.schema("item") }} import ItemCreate, ItemUpdate

MAX_PAGE_SIZE = 100
DEFAULT_PAGE_SIZE = 50


class ItemNotFoundError(Exception):
    """Raised when an item does not exist."""

    def __init__(self, item_id: int) -> None:
        super().__init__(f"Item {item_id} was not found")
        self.item_id = item_id


def _validate_pagination(limit: int, offset: int) -> None:
    if not 1 <= limit <= MAX_PAGE_SIZE:
        raise ValueError(f"limit must be between 1 and {MAX_PAGE_SIZE}")
    if offset < 0:
        raise ValueError("offset must be greater than or equal to 0")


async def create_item(
    session: AsyncSession,
    payload: ItemCreate,
{% if spec.has("auth-jwt") %}
    owner_id: int,
{% endif %}
) -> Item:
    """Create and persist a new item."""
    data = payload.model_dump()
{% if spec.has("auth-jwt") %}
    data["owner_id"] = owner_id
{% endif %}
    item = Item(**data)
    session.add(item)
    await session.commit()
    await session.refresh(item)
    return item


async def list_items(
    session: AsyncSession,
{% if spec.has("auth-jwt") %}
    owner_id: int,
{% endif %}
    *,
    limit: int = DEFAULT_PAGE_SIZE,
    offset: int = 0,
) -> list[Item]:
    """Return a bounded page of items ordered by id."""
    _validate_pagination(limit, offset)
{% if spec.has("sqlmodel") %}
    statement = select(Item)
{% if spec.has("auth-jwt") %}
    statement = statement.where(Item.owner_id == owner_id)
{% endif %}
    statement = statement.order_by("id").limit(limit).offset(offset)
    result = await session.exec(statement)
    return list(result.all())
{% else %}
    statement = select(Item)
{% if spec.has("auth-jwt") %}
    statement = statement.where(Item.owner_id == owner_id)
{% endif %}
    statement = statement.order_by(Item.id).limit(limit).offset(offset)
    result = await session.execute(statement)
    return list(result.scalars().all())
{% endif %}


async def get_item(
    session: AsyncSession,
    item_id: int,
{% if spec.has("auth-jwt") %}
    owner_id: int,
{% endif %}
) -> Item:
    """Return one item or raise a domain error."""
{% if spec.has("auth-jwt") %}
{% if spec.has("sqlmodel") %}
    result = await session.exec(
        select(Item).where(Item.id == item_id, Item.owner_id == owner_id)
    )
    item = result.first()
{% else %}
    result = await session.execute(
        select(Item).where(Item.id == item_id, Item.owner_id == owner_id)
    )
    item = result.scalar_one_or_none()
{% endif %}
{% else %}
    item = await session.get(Item, item_id)
{% endif %}
    if item is None:
        raise ItemNotFoundError(item_id)
    return item


async def update_item(
    session: AsyncSession,
    item_id: int,
    payload: ItemUpdate,
{% if spec.has("auth-jwt") %}
    owner_id: int,
{% endif %}
) -> Item:
    """Apply the provided fields to an existing item."""
{% if spec.has("auth-jwt") %}
    item = await get_item(session, item_id, owner_id)
{% else %}
    item = await get_item(session, item_id)
{% endif %}
    for field, value in payload.model_dump(exclude_unset=True).items():
        setattr(item, field, value)
    await session.commit()
    await session.refresh(item)
    return item


async def delete_item(
    session: AsyncSession,
    item_id: int,
{% if spec.has("auth-jwt") %}
    owner_id: int,
{% endif %}
) -> None:
    """Delete an existing item."""
{% if spec.has("auth-jwt") %}
    item = await get_item(session, item_id, owner_id)
{% else %}
    item = await get_item(session, item_id)
{% endif %}
    await session.delete(item)
    await session.commit()
