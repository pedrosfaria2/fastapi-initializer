oauth2_scheme = OAuth2PasswordBearer(tokenUrl="/auth/login")

_DUMMY_PASSWORD_HASH = hash_password("unused-password-for-timing")


class EmailAlreadyRegisteredError(DomainError):
    """Raised when an email address is already registered."""

    status_code = 409
    code = "email_already_registered"


class InvalidCredentialsError(DomainError):
    """Raised when the supplied credentials are not valid."""

    status_code = 401
    code = "invalid_credentials"


{% if spec.has("email") %}
class UnverifiedEmailError(DomainError):
    """Raised when the account email has not been verified."""

    status_code = 403
    code = "email_not_verified"


{% endif %}
async def get_user_by_email(session: AsyncSession, email: str) -> User | None:
    """Return the user with the given canonical email, if it exists."""
    try:
        normalized = normalize_email(email)
    except ValueError:
        return None
    statement = select(User).where(User.email == normalized)
    result = await session.execute(statement)
    return result.scalar_one_or_none()


async def create_user(session: AsyncSession, payload: UserCreate) -> User:
    """Register a new user with a hashed password."""
    existing = await get_user_by_email(session, payload.email)
    if existing is not None:
        raise EmailAlreadyRegisteredError("Email is already registered")
    user = User(
        email=payload.email,
        hashed_password=hash_password(payload.password),
    )
    session.add(user)
    try:
        await session.commit()
    except IntegrityError as exc:
        await session.rollback()
        raise EmailAlreadyRegisteredError("Email is already registered") from exc
    await session.refresh(user)
    return user


async def authenticate_user(session: AsyncSession, email: str, password: str) -> User:
    """Return the user matching the credentials or raise a domain error."""
    user = await get_user_by_email(session, email)
    if user is None:
        # Verify a dummy hash so missing and wrong-password attempts take similar time.
        verify_password(password, _DUMMY_PASSWORD_HASH)
        raise InvalidCredentialsError("Incorrect email or password")
    if not verify_password(password, user.hashed_password):
        raise InvalidCredentialsError("Incorrect email or password")
    if not user.is_active:
        raise InvalidCredentialsError("Inactive user")
{% if spec.has("email") %}
    if get_settings().require_verified_email and not user.is_verified:
        raise UnverifiedEmailError("Email address is not verified")
{% endif %}
    return user


def _credentials_error() -> HTTPException:
    return HTTPException(
        status_code=status.HTTP_401_UNAUTHORIZED,
        detail="Could not validate credentials",
        headers={"WWW-Authenticate": "Bearer"},
    )


async def get_token_payload(
    token: Annotated[str, Depends(oauth2_scheme)],
) -> TokenPayload:
    """Return the claims of a valid access token."""
    token_payload = decode_access_token(token)
    if token_payload is None:
        raise _credentials_error()
    return token_payload


TokenPayloadDep = Annotated[TokenPayload, Depends(get_token_payload)]


async def get_current_user(
    session: SessionDep,
    token_payload: TokenPayloadDep,
) -> User:
    """Return the user identified by the bearer token."""
    user = await get_user_by_email(session, token_payload.sub)
    if user is None or not user.is_active or token_payload.ver != user.token_version:
        raise _credentials_error()
    if await session.get(RevokedToken, token_payload.jti) is not None:
        raise _credentials_error()
    return user


CurrentUser = Annotated[User, Depends(get_current_user)]


async def revoke_access_token(
    session: AsyncSession,
    token_payload: TokenPayload,
) -> None:
    """Revoke one access token until its expiry."""
    await session.execute(delete(RevokedToken).where(RevokedToken.expires_at <= datetime.now(UTC)))
    session.add(
        RevokedToken(
            jti=token_payload.jti,
            expires_at=datetime.fromtimestamp(token_payload.exp, UTC),
        )
    )
    try:
        await session.commit()
    except IntegrityError:
        await session.rollback()


async def revoke_user_tokens(session: AsyncSession, user: User) -> None:
    """Invalidate every access and pending action token for the account."""
    statement = update(User).where(User.id == user.id)
{% if spec.has("email") %}
    statement = statement.values(
        token_version=User.token_version + 1,
        password_reset_version=User.password_reset_version + 1,
        email_verification_version=User.email_verification_version + 1,
    )
{% else %}
    statement = statement.values(token_version=User.token_version + 1)
{% endif %}
    await session.execute(statement)
    await session.commit()


def issue_access_token(user: User) -> str:
    """Create an access token for a user."""
    return create_access_token(user.email, user.token_version)
