def create_app() -> FastAPI:
    """Build the FastAPI application."""
    settings = get_settings()
    configure_logging(settings.log_level)
{% if spec.has("sentry") %}
    init_sentry(settings)
{% endif %}
    docs_enabled = settings.environment.lower() != "production"
    app = FastAPI(
        title=settings.app_name,
        version=__version__,
        docs_url="/docs" if docs_enabled else None,
        redoc_url="/redoc" if docs_enabled else None,
        openapi_url="/openapi.json" if docs_enabled else None,
    )
{% if spec.has("opentelemetry") %}
    configure_tracing(app, settings)
{% endif %}
{% if spec.has("cors") %}
    app.add_middleware(
        CORSMiddleware,
        allow_origins=settings.cors_origins,
        allow_credentials=True,
        allow_methods=["*"],
        allow_headers=["*"],
    )
{% endif %}
    app.add_middleware(RequestIdMiddleware)
    app.add_middleware(GZipMiddleware, minimum_size=1024)

    allowed_methods: dict[str, set[str]] = {}

    @app.middleware("http")
    async def security_middleware(
        request: Request,
        call_next: Callable[[Request], Awaitable[Response]],
    ) -> Response:
        if not settings.forwarded_allow_ips and request.headers.get("x-forwarded-for"):
            response: Response = JSONResponse(
                status_code=400,
                content={"detail": "Untrusted proxy headers"},
            )
        else:
            response = await call_next(request)
        response.headers.setdefault("X-Content-Type-Options", "nosniff")
        response.headers.setdefault("X-Frame-Options", "DENY")
        response.headers.setdefault("Referrer-Policy", "no-referrer")
        if request.url.path.startswith("/auth"):
            response.headers.setdefault("Cache-Control", "no-store")
            response.headers.setdefault("Pragma", "no-cache")
            vary = response.headers.get("Vary")
            response.headers["Vary"] = f"{vary}, Authorization" if vary else "Authorization"
        if request.url.scheme == "https":
            response.headers.setdefault(
                "Strict-Transport-Security",
                "max-age=31536000; includeSubDomains",
            )
        if response.status_code == 405:
            for pattern, methods in allowed_methods.items():
                if re.fullmatch(pattern, request.url.path):
                    response.headers["Allow"] = ", ".join(sorted(methods))
                    break
        return response

    install_error_handlers(app)

    @app.get("/health")
    def health() -> dict[str, str]:
        """Return service liveness."""
        return {"status": "ok"}

    @app.get("/ready")
    def ready() -> dict[str, str]:
        """Return service readiness."""
        return {"status": "ready"}

{% if spec.has("prometheus") %}
    Instrumentator().instrument(app).expose(app)
{% endif %}
    return app


app = create_app()


