{% if spec.has_database %}
@asynccontextmanager
async def lifespan(app: FastAPI) -> AsyncGenerator[None]:
    """Create the database engine for the application lifetime."""
    engine = create_async_engine(get_settings().database_url)
    session_factory: SessionFactory = async_sessionmaker(engine, expire_on_commit=False)
    app.state.engine = engine
    app.state.session_factory = session_factory
    try:
        yield
    finally:
        await engine.dispose()


{% endif %}
def create_app() -> FastAPI:
    """Build the FastAPI application."""
    settings = get_settings()
    configure_logging(settings.log_level)
{% if spec.has("sentry") %}
    init_sentry(settings)
{% endif %}
    app = FastAPI(
        title=settings.app_name,
        version=__version__,
{% if spec.has_database %}
        lifespan=lifespan,
{% endif %}
    )
{% if spec.has("opentelemetry") %}
    configure_tracing(app, settings)
{% endif %}
{% if spec.has("oauth2") %}
    app.add_middleware(SessionMiddleware, secret_key=settings.secret_key)
{% endif %}
{% if spec.has("cors") %}
    app.add_middleware(
        CORSMiddleware,
        allow_origins=settings.cors_origins,
        allow_credentials=True,
        allow_methods=["*"],
        allow_headers=["*"],
    )
{% endif %}
{% if spec.has("rate-limit") %}
    app.state.limiter = limiter
    app.add_exception_handler(RateLimitExceeded, rate_limit_exceeded_handler)
    app.add_middleware(SlowAPIMiddleware)
{% endif %}
    app.add_middleware(RequestIdMiddleware)
    install_error_handlers(app)
    app.include_router(api_router)
{% if spec.has("static-templates") %}
    app.mount(
        "/static",
        StaticFiles(directory=Path(__file__).resolve().parents[2] / "static"),
        name="static",
    )
{% endif %}
{% if spec.has("prometheus") %}
    Instrumentator().instrument(app).expose(app)
{% endif %}
    return app


app = create_app()


def main() -> None:
    """Run the development server."""
    import uvicorn

    uvicorn.run("{{ spec.package }}.main:app", host="127.0.0.1", port=8000)
