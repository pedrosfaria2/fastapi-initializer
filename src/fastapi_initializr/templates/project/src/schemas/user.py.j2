"""User and authentication schemas."""

from datetime import UTC, datetime
from typing import Annotated, Literal

from email_validator import EmailNotValidError, validate_email
from pydantic import (
    AfterValidator,
    BaseModel,
    ConfigDict,
    Field,
    StrictInt,
    WithJsonSchema,
    field_serializer,
)


def normalize_email(value: str) -> str:
    """Return the canonical lowercase form of an email address."""
    try:
        validated = validate_email(value, check_deliverability=False, test_environment=True)
    except EmailNotValidError as error:
        raise ValueError(str(error)) from error
    return validated.normalized.lower()


EmailAddress = Annotated[
    str,
    WithJsonSchema({"type": "string", "format": "email"}),
    AfterValidator(normalize_email),
]


class UserCreate(BaseModel):
    """Fields accepted when registering a user."""

    email: EmailAddress
    password: str = Field(min_length=12, max_length=128)


class UserRead(BaseModel):
    """A user returned by the API."""

    model_config = ConfigDict(from_attributes=True)

    id: int
    email: EmailAddress
    is_active: bool
{% if spec.has("email") %}
    is_verified: bool
{% endif %}
    created_at: datetime

    @field_serializer("created_at")
    def serialize_created_at(self, value: datetime) -> datetime:
        """Return an aware UTC timestamp for the API contract."""
        return value.replace(tzinfo=UTC) if value.tzinfo is None else value.astimezone(UTC)


class Token(BaseModel):
    """An access token response."""

    access_token: str
    token_type: str = Field(default="bearer")


class TokenPayload(BaseModel):
    """Decoded access token claims."""

    sub: str = Field(min_length=1)
    exp: StrictInt
    ver: StrictInt
    typ: Literal["access"]
    iss: str = Field(min_length=1)
    aud: str = Field(min_length=1)
    jti: str = Field(min_length=1)
