"""Shared API dependencies."""
{% if spec.has_database %}

from collections.abc import AsyncIterator
from typing import Annotated, cast

from fastapi import Depends, Request
{% if spec.has("sqlmodel") %}
from sqlmodel.ext.asyncio.session import AsyncSession
{% else %}
from sqlalchemy.ext.asyncio import AsyncSession
{% endif %}

from {{ spec.package }}.db.session import SessionFactory


async def get_session(request: Request) -> AsyncIterator[AsyncSession]:
    """Yield a database session scoped to the request."""
    session_factory = cast(SessionFactory, request.app.state.session_factory)
    async with session_factory() as session:
        yield session


SessionDep = Annotated[AsyncSession, Depends(get_session)]
{% endif %}
