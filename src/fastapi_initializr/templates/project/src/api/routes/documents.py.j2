"""Document CRUD endpoints."""

from typing import Annotated

from fastapi import APIRouter, HTTPException, Query, status

from {{ spec.package }}.schemas.document import (
    DocumentCreate,
    DocumentRead,
    DocumentUpdate,
)
from {{ spec.package }}.services.documents import (
    DEFAULT_PAGE_SIZE,
    MAX_PAGE_SIZE,
    DocumentNotFoundError,
    create_document,
    delete_document,
    get_document,
    list_documents,
    update_document,
)

router = APIRouter(prefix="/documents", tags=["documents"])


def _read(document: object) -> DocumentRead:
    return DocumentRead.model_validate(document)


@router.post("", response_model=DocumentRead, status_code=status.HTTP_201_CREATED)
async def create_document_endpoint(payload: DocumentCreate) -> DocumentRead:
    """Create a document."""
    return _read(await create_document(payload))


@router.get("", response_model=list[DocumentRead])
async def list_documents_endpoint(
    limit: Annotated[int, Query(ge=1, le=MAX_PAGE_SIZE)] = DEFAULT_PAGE_SIZE,
    offset: Annotated[int, Query(ge=0)] = 0,
) -> list[DocumentRead]:
    """List documents with bounded pagination."""
    documents = await list_documents(limit=limit, offset=offset)
    return [_read(document) for document in documents]


@router.get("/{document_id}", response_model=DocumentRead)
async def get_document_endpoint(document_id: str) -> DocumentRead:
    """Return one document."""
    try:
        document = await get_document(document_id)
    except DocumentNotFoundError as error:
        raise HTTPException(
            status_code=status.HTTP_404_NOT_FOUND,
            detail="Document not found",
        ) from error
    return _read(document)


@router.patch("/{document_id}", response_model=DocumentRead)
async def update_document_endpoint(
    document_id: str,
    payload: DocumentUpdate,
) -> DocumentRead:
    """Update a document."""
    try:
        document = await update_document(document_id, payload)
    except DocumentNotFoundError as error:
        raise HTTPException(
            status_code=status.HTTP_404_NOT_FOUND,
            detail="Document not found",
        ) from error
    return _read(document)


@router.delete("/{document_id}", status_code=status.HTTP_204_NO_CONTENT)
async def delete_document_endpoint(document_id: str) -> None:
    """Delete a document."""
    try:
        await delete_document(document_id)
    except DocumentNotFoundError as error:
        raise HTTPException(
            status_code=status.HTTP_404_NOT_FOUND,
            detail="Document not found",
        ) from error
