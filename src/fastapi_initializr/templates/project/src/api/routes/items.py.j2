"""Item CRUD endpoints."""

from typing import Annotated

from fastapi import APIRouter, HTTPException, Query, status

from {{ spec.package }}.api.dependencies import SessionDep
from {{ spec.package }}.schemas.item import ItemCreate, ItemRead, ItemUpdate
from {{ spec.package }}.services.items import (
    DEFAULT_PAGE_SIZE,
    MAX_PAGE_SIZE,
    ItemNotFoundError,
    create_item,
    delete_item,
    get_item,
    list_items,
    update_item,
)

router = APIRouter(prefix="/items", tags=["items"])


@router.post("", response_model=ItemRead, status_code=status.HTTP_201_CREATED)
async def create_item_endpoint(payload: ItemCreate, session: SessionDep) -> ItemRead:
    """Create an item."""
    item = await create_item(session, payload)
    return ItemRead.model_validate(item)


@router.get("", response_model=list[ItemRead])
async def list_items_endpoint(
    session: SessionDep,
    limit: Annotated[int, Query(ge=1, le=MAX_PAGE_SIZE)] = DEFAULT_PAGE_SIZE,
    offset: Annotated[int, Query(ge=0)] = 0,
) -> list[ItemRead]:
    """List items with bounded pagination."""
    items = await list_items(session, limit=limit, offset=offset)
    return [ItemRead.model_validate(item) for item in items]


@router.get("/{item_id}", response_model=ItemRead)
async def get_item_endpoint(item_id: int, session: SessionDep) -> ItemRead:
    """Return one item."""
    try:
        item = await get_item(session, item_id)
    except ItemNotFoundError as error:
        raise HTTPException(
            status_code=status.HTTP_404_NOT_FOUND,
            detail="Item not found",
        ) from error
    return ItemRead.model_validate(item)


@router.patch("/{item_id}", response_model=ItemRead)
async def update_item_endpoint(
    item_id: int,
    payload: ItemUpdate,
    session: SessionDep,
) -> ItemRead:
    """Update an item."""
    try:
        item = await update_item(session, item_id, payload)
    except ItemNotFoundError as error:
        raise HTTPException(
            status_code=status.HTTP_404_NOT_FOUND,
            detail="Item not found",
        ) from error
    return ItemRead.model_validate(item)


@router.delete("/{item_id}", status_code=status.HTTP_204_NO_CONTENT)
async def delete_item_endpoint(item_id: int, session: SessionDep) -> None:
    """Delete an item."""
    try:
        await delete_item(session, item_id)
    except ItemNotFoundError as error:
        raise HTTPException(
            status_code=status.HTTP_404_NOT_FOUND,
            detail="Item not found",
        ) from error
