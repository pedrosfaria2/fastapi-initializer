"""File upload endpoints."""

from typing import Annotated

from fastapi import APIRouter, Depends, HTTPException, UploadFile, status
from fastapi.responses import Response

from {{ spec.package }}.core.config import Settings, get_settings
from {{ spec.package }}.core.storage import Storage, get_storage, new_storage_key
from {{ spec.package }}.{{ layout.service("auth") }} import CurrentUser

router = APIRouter(prefix="/uploads", tags=["uploads"])
SettingsDep = Annotated[Settings, Depends(get_settings)]
StorageDep = Annotated[Storage, Depends(get_storage)]


def _owned_key(owner_id: int, key: str) -> str:
    """Reject keys that are not owned by the authenticated user."""
    if not key.startswith(f"{owner_id}-"):
        raise HTTPException(
            status_code=status.HTTP_404_NOT_FOUND,
            detail="File not found",
        )
    return key


@router.post("", status_code=status.HTTP_201_CREATED)
async def upload_file(
    file: UploadFile,
    storage: StorageDep,
    settings: SettingsDep,
    current_user: CurrentUser,
) -> dict[str, str]:
    """Validate and store an uploaded file for the authenticated user."""
    if file.content_type not in settings.allowed_upload_types:
        raise HTTPException(
            status_code=status.HTTP_415_UNSUPPORTED_MEDIA_TYPE,
            detail="Upload type is not allowed",
        )
    data = await file.read(settings.max_upload_bytes + 1)
    if len(data) > settings.max_upload_bytes:
        raise HTTPException(
            status_code=status.HTTP_413_CONTENT_TOO_LARGE,
            detail="Upload exceeds the size limit",
        )
    key = new_storage_key(file.filename or "upload", current_user.id)
    await storage.save(key, data)
    return {"key": key}


@router.get("/{key}")
async def download_file(
    key: str,
    storage: StorageDep,
    current_user: CurrentUser,
) -> Response:
    """Return a stored file owned by the authenticated user or ``404``."""
    key = _owned_key(current_user.id, key)
    try:
        data = await storage.read(key)
    except ValueError as error:
        raise HTTPException(
            status_code=status.HTTP_404_NOT_FOUND,
            detail="File not found",
        ) from error
    if data is None:
        raise HTTPException(
            status_code=status.HTTP_404_NOT_FOUND,
            detail="File not found",
        )
    return Response(content=data, media_type="application/octet-stream")


@router.delete("/{key}", status_code=status.HTTP_204_NO_CONTENT)
async def delete_file(
    key: str,
    storage: StorageDep,
    current_user: CurrentUser,
) -> None:
    """Delete a stored file owned by the authenticated user."""
    key = _owned_key(current_user.id, key)
    try:
        await storage.delete(key)
    except ValueError as error:
        raise HTTPException(
            status_code=status.HTTP_404_NOT_FOUND,
            detail="File not found",
        ) from error
