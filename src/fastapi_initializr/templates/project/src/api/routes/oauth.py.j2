"""OAuth2 and OIDC login endpoints."""

from typing import Annotated

from fastapi import APIRouter, Depends, HTTPException, Request, status
from starlette.responses import Response

from {{ spec.package }}.api.dependencies import SessionDep
from {{ spec.package }}.core.auth_throttle import OAUTH_LIMIT, auth_rate_limit
from {{ spec.package }}.core.config import get_settings
from {{ spec.package }}.core.oauth import (
    OAuthCallbackError,
    OAuthClient,
    OAuthProviderName,
    ensure_supported_provider,
    get_oauth_client,
)
{% if layout.is_feature %}
from {{ spec.package }}.{{ layout.service("oauth") }} import (
    fetch_provider_identity,
    get_or_create_oauth_user,
)
from {{ spec.package }}.{{ layout.schema("user") }} import Token
from {{ spec.package }}.{{ layout.service("auth") }} import issue_access_token
{% else %}
from {{ spec.package }}.{{ layout.schema("user") }} import Token
from {{ spec.package }}.{{ layout.service("auth") }} import issue_access_token
from {{ spec.package }}.{{ layout.service("oauth") }} import (
    fetch_provider_identity,
    get_or_create_oauth_user,
)
{% endif %}

router = APIRouter(prefix="/auth/oauth", tags=["oauth"])

OAuthClientDep = Annotated[OAuthClient, Depends(get_oauth_client)]


def _callback_url(provider: str) -> str:
    base_url = get_settings().oauth_redirect_base_url.rstrip("/")
    return f"{base_url}/auth/oauth/{provider}/callback"


@router.get(
    "/{provider}/login",
    responses={302: {"description": "Redirect to the provider authorization page"}},
    dependencies=[Depends(auth_rate_limit("oauth_login", OAUTH_LIMIT))],
)
async def login(
    provider: OAuthProviderName,
    request: Request,
    client: OAuthClientDep,
) -> Response:
    """Redirect the browser to the provider authorization page."""
    ensure_supported_provider(provider)
    return await client.authorize_redirect(request, _callback_url(provider))


@router.get(
    "/{provider}/callback",
    response_model=Token,
    responses={
        400: {"description": "Invalid provider identity"},
        403: {"description": "Invalid callback or state"},
        409: {"description": "Email already belongs to a password account"},
    },
    dependencies=[Depends(auth_rate_limit("oauth_callback", OAUTH_LIMIT))],
)
async def callback(
    provider: OAuthProviderName,
    request: Request,
    session: SessionDep,
    client: OAuthClientDep,
) -> Token:
    """Exchange a provider callback for a local access token."""
    ensure_supported_provider(provider)
    try:
        token = await client.authorize_access_token(request)
    except OAuthCallbackError as error:
        raise HTTPException(
            status_code=status.HTTP_403_FORBIDDEN,
            detail="OAuth callback rejected",
        ) from error
    identity = await fetch_provider_identity(provider, token, client)
    if identity is None:
        raise HTTPException(
            status_code=status.HTTP_400_BAD_REQUEST,
            detail="Provider did not return a verified identity",
        )
    user = await get_or_create_oauth_user(session, provider, identity)
    return Token(access_token=issue_access_token(user))
