repos:
  - repo: https://github.com/astral-sh/ruff-pre-commit
    rev: v{{ ruff_version }}
    hooks:
      - id: ruff-check
        args: ["--fix"]
      - id: ruff-format
  - repo: local
    hooks:
      - id: mypy
        name: mypy
        entry: uv run mypy src
        language: system
        types: [python]
        pass_filenames: false
      - id: pyright
        name: pyright
        entry: uv run pyright src
        language: system
        types: [python]
        pass_filenames: false
{% if spec.has("security-scan") %}
      - id: pip-audit
        name: pip-audit
        entry: uv run pip-audit
        language: system
        pass_filenames: false
      - id: bandit
        name: bandit
        entry: uv run bandit -r src -q
        language: system
        types: [python]
        pass_filenames: false
{% endif %}
