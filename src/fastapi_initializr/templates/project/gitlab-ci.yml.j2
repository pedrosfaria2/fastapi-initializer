stages:
  - lint
  - typecheck
  - test

default:
  image: ghcr.io/astral-sh/uv:latest
  before_script:
    - uv sync

lint:
  stage: lint
  script:
    - uv run ruff format --check .
    - uv run ruff check .

typecheck:
  stage: typecheck
  script:
    - uv run mypy src
    - uv run pyright src

test:
  stage: test
  script:
    - uv run pytest
